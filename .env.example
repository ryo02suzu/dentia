# ── dentia 環境変数 ──
# このファイルをコピーして .env を作成し、値を入れてください:
#   cp .env.example .env

# Anthropic Claude API キー（AI②：SOAP生成に必須）
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API キー（AI①：録音の文字起こし=Whisper に必須）
# https://platform.openai.com/api-keys で取得
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 文字起こしエンジン（STT Adapter）──  詳細: docs/stt-migration-plan.md
# 主エンジン: openai(既定/whisper-1) | amivoice(国産API・未実装) | selfhost(自前・未実装)
# STT_PROVIDER=openai
# 予備エンジン（カンマ区切り・順に試行）。主エンジン障害時のフォールバック。
#   例: STT_FALLBACK=amivoice,openai（※openaiは米国送信。コンプラ厳格運用では外す）
# STT_FALLBACK=
# 後処理のLLM正規化（表記正規化のみ）。既定off。辞書置換(stt/dictionary.js)は常時ON。
# STT_POSTPROCESS_LLM=off
# 国産STT（フェーズ1で実装時に使用）
# AMIVOICE_API_KEY=
# AMIVOICE_ENDPOINT=
# 自前STT（フェーズ3で実装時に使用）
# SELFHOST_STT_URL=

# Supabase（ログイン・カルテ保存）— dentia 専用の新しいプロジェクトの値を使うこと
#   過去の別プロジェクト（予約システム等）のキーは使わない
#   Supabase ダッシュボード → Project Settings → API から取得
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxx.your-anon-public-key.xxxxxxxx
# ↑ anon(public)キーはクライアントで使う公開鍵。データ保護はRLSが担保する。
#   未設定の場合、アプリはログイン無しの従来モードで動作します。

# 1ユーザーあたり1日の利用上限（任意・既定200）。生成＋文字起こしの合計回数。
# 有効化には Supabase で supabase/usage.sql を実行する必要があります。
# DAILY_API_LIMIT=200

# 1回の生成に渡せる会話の最大文字数（任意・既定16000）。過大なトークン課金の防止。
# MAX_CONVERSATION_CHARS=16000

# クローズドβの招待コード（任意）。設定すると新規登録にこのコードが必要になる。
# 未設定なら誰でも登録可能（開発用）。20院ベータでは必ず設定すること。
# BETA_INVITE_CODE=dentia-beta-2026

# 使用モデル（任意）
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# サーバーのポート（任意・既定は 3000）
# PORT=3000
