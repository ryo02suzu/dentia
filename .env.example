# Anthropic Claude API キー
# https://console.anthropic.com/ で取得したキーを設定してください。
# このファイルをコピーして .env を作成し、値を入れてください:
#   cp .env.example .env
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用するモデル（任意・既定は claude-sonnet-4-6）
# ANTHROPIC_MODEL=claude-sonnet-4-6

# サーバーのポート（任意・既定は 3000）
# PORT=3000
